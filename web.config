<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified"/>
    </handlers>
    <httpPlatform processPath="C:\Users\MANNY.DEV1\AppData\Roaming\uv\python\cpython-3.14.3-windows-x86_64-none\python.exe"
                  arguments="C:\Publish\ScanShip\run_server.py"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\Publish\ScanShip\logs\app.log"
                  startupTimeLimit="60"
                  processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="HTTP_PLATFORM_PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="PYTHONPATH" value="C:\Publish\ScanShip\.venv\Lib\site-packages;C:\Publish\ScanShip" />
        <!-- Without this, stdout stays buffered and the [SYNC] / [PURGE] / [RECONCILE]
             prints never reach stdoutLogFile until the process dies. -->
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
